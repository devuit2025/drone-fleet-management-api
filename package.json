{
    "name": "dronefleetmanagement-api",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "build": "nest build",
        "dev": "nest start --watch",
        "start": "nest start",
        "start:dev": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true && nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.{ts,tsx,js}\" --max-warnings=0",
        "lint:fix": "eslint \"{src,apps,libs,test}/**/*.{ts,tsx,js}\" --fix",
        "format": "prettier --write \"{src,apps,libs,test}/**/*.{ts,tsx,js,json,md}\"",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "seed": "ts-node -r tsconfig-paths/register src/seeders/seed.command.ts",
        "seed:simple": "ts-node -r tsconfig-paths/register src/seeders/simple-seed.command.ts",
        "seed:no-faker": "ts-node -r tsconfig-paths/register src/seeders/no-faker-seed.command.ts",
        "kill:dev": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true",
        "migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d data-source.ts",
        "migration:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d data-source.ts",
        "migration:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate",
        "db:drop": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js schema:drop -d data-source.ts",
        "db:reset": "npm run db:drop && npm run migration:run && npm run seed",
        "db:reset:nofaker": "npm run db:drop && npm run migration:run && npm run seed:no-faker"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/devuit2025/DroneFleetManagement-api.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/devuit2025/DroneFleetManagement-api/issues"
    },
    "homepage": "https://github.com/devuit2025/DroneFleetManagement-api#readme",
    "dependencies": {
        "@nestjs/common": "^11.1.6",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^11.1.6",
        "@nestjs/jwt": "^11.0.1",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.1.6",
        "@nestjs/platform-socket.io": "^11.1.6",
        "@nestjs/swagger": "^11.2.0",
        "@nestjs/typeorm": "^11.0.0",
        "@nestjs/websockets": "^11.1.6",
        "bcryptjs": "^3.0.2",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "jsonwebtoken": "^9.0.2",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "passport-local": "^1.0.0",
        "pg": "^8.16.3",
        "postgis": "^1.0.6",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "socket.io": "^4.8.1",
        "typeorm": "^0.3.27",
        "uuid": "^13.0.0"
    },
    "devDependencies": {
        "@faker-js/faker": "^10.0.0",
        "@nestjs/cli": "^11.0.10",
        "@nestjs/testing": "^11.1.6",
        "@types/bcryptjs": "^3.0.0",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^24.7.2",
        "@types/passport-jwt": "^4.0.1",
        "@types/passport-local": "^1.0.38",
        "@types/supertest": "^6.0.3",
        "@types/uuid": "^11.0.0",
        "@typescript-eslint/eslint-plugin": "^8.46.0",
        "@typescript-eslint/parser": "^8.46.0",
        "eslint": "^9.37.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.4",
        "eslint-plugin-sonarjs": "^3.0.5",
        "jest": "^29.7.0",
        "jest-mock-extended": "^4.0.0",
        "nodemon": "^3.1.10",
        "prettier": "^3.6.2",
        "supertest": "^7.1.4",
        "ts-jest": "^29.4.5",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    }
}
